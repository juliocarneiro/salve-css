---
import 'salve-css';
import 'salve-icons/css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>__PROJECT_NAME__</title>
    <!-- Applies the saved theme before the first paint (salve-css/theme). -->
    <script is:inline>(function(){try{var t=localStorage.getItem('salve-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t)}catch(e){}})();</script>
  </head>
  <body>
    <slot />
  </body>
</html>
