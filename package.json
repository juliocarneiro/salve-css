{
  "name": "salve-css",
  "version": "0.2.0",
  "description": "CSS that eases the pain: a pure-CSS design system that fixes the everyday pains of styling the web. Cascade layers, OKLCH themes, intrinsic layouts, native accessible components, ready-made animations and utilities. Zero build, SSR-ready.",
  "type": "module",
  "main": "dist/salve.css",
  "style": "dist/salve.css",
  "exports": {
    ".": "./dist/salve.css",
    "./min": "./dist/salve.min.css",
    "./theme": {
      "types": "./runtime/theme.d.ts",
      "default": "./runtime/theme.js"
    },
    "./src/*": "./src/*",
    "./build": "./lib/build.js"
  },
  "bin": {
    "salve": "bin/salve.js"
  },
  "files": [
    "dist",
    "src",
    "lib",
    "bin",
    "runtime",
    "CHANGELOG.md",
    "README.pt-BR.md"
  ],
  "scripts": {
    "build": "node bin/salve.js build -c none -o dist/salve.css && node bin/salve.js build -c none -m -o dist/salve.min.css",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "accessibility",
    "animations",
    "cascade-layers",
    "components",
    "container-queries",
    "css",
    "css-framework",
    "dark-mode",
    "design-system",
    "motion",
    "nextjs",
    "oklch",
    "react",
    "ssr",
    "tailwind-alternative",
    "utility-first"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "*.css"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juliocarneiro/salve-css.git"
  },
  "homepage": "https://github.com/juliocarneiro/salve-css#readme",
  "bugs": {
    "url": "https://github.com/juliocarneiro/salve-css/issues"
  },
  "author": "Julio Carneiro"
}
